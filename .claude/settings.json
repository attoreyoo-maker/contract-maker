{
  "disableAllHooks": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["C:/Users/user/Desktop/my_service/.claude/hooks/prd_lock.py"],
            "timeout": 15,
            "statusMessage": "PRD 자물쇠 확인 중"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["C:/Users/user/Desktop/my_service/.claude/hooks/task_check.py"],
            "timeout": 15,
            "statusMessage": "할 일 검사 중"
          }
        ]
      }
    ]
  }
}
